# .gitignore de shell de pruebas (ADR-003)
# Basado en helpers/gitignore-template.txt de battlehub-contracts,
# adaptado para el stack del Shell: Aurelia 2 + Webpack (Node/TypeScript).

# ===== General / SO =====
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp

# ===== Variables de entorno / secretos =====
# Aquí van el dominio y el clientId de Auth0 y las URLs de los remotes.
# Nunca se suben: solo se versiona .env.example con valores de ejemplo.
.env
.env.*
!.env.example
*.pfx
*.pem

# ===== IDEs / Editores =====
.vs/
.vscode/
.idea/
*.suo
*.user

# ===== Node / JavaScript / TypeScript =====
node_modules/
dist/
build/
coverage/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== Webpack / caché de build =====
.cache/
.webpack/
*.tsbuildinfo

# ===== Artefactos de pruebas/CI =====
test-results/
playwright-report/

# Copiar a .env.development para npm start; .env para npm run build.
# Estos valores se incluyen en el navegador. Nunca agregar Client Secret ni tokens.
BATTLEHUB_AUTH_MODE=mock
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
# Origen del servicio, sin /api/profiles. Confirmar puerto y protocolo con Equipo 1.
PROFILE_SERVICE_URL=
# Opcional: ruta del JSON unificado, solo cuando Profile confirme su endpoint.
# Vacio mantiene los endpoints actuales; no implementa por si solo Auth0 M2M.
PROFILE_ACCESS_PATH=
MATCHMAKING_SERVICE_URL=

# Servidor Docker/Railway: JSON publico, solo remotes confiables con URL HTTPS.
REMOTES_CONFIG_JSON={}
# Puerto de la vista previa local con Compose.
SHELL_PORT=4000
